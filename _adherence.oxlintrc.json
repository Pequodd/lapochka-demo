{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/feedback/**",
              "components/product/**",
              "components/shell/**",
              "components/structure/**",
              "ui_kits/store/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Montserrat))/i]",
        "message": "Font not provided by the design system. Available: Montserrat."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccordionItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|content|key|ref|className|style|children)$/]",
        "message": "<AccordionItem> doesn't accept that prop. Declared props: title, content."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:new|hit|sale|soon|classic|retro|water|collab)$/]",
        "message": "<Badge> tone must be one of 'new' | 'hit' | 'sale' | 'soon' | 'classic' | 'retro' | 'water' | 'collab'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|loading|fullWidth|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, loading, fullWidth, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|tertiary)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'tertiary'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<Button> size must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CartLine'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|name|price|quantity|pack|image|key|ref|className|style|children)$/]",
        "message": "<CartLine> doesn't accept that prop. Declared props: id, name, price, quantity, pack, image."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:selected|line|count|children|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: selected, line, count, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute[name.name='line'] > Literal[value!=/^(?:classic|retro|water|collab)$/]",
        "message": "<Chip> line must be one of 'classic' | 'retro' | 'water' | 'collab'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|description|actionLabel|onAction|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: title, description, actionLabel, onAction."
      },
      {
        "selector": "JSXOpeningElement[name.name='Gallery'] > JSXAttribute > JSXIdentifier[name!=/^(?:views|images|key|ref|className|style|children)$/]",
        "message": "<Gallery> doesn't accept that prop. Declared props: views, images."
      },
      {
        "selector": "JSXOpeningElement[name.name='Header'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|scrolled|city|cartCount|active|onCartClick|onNavigate|key|ref|className|style|children)$/]",
        "message": "<Header> doesn't accept that prop. Declared props: variant, scrolled, city, cartCount, active, onCartClick, onNavigate."
      },
      {
        "selector": "JSXOpeningElement[name.name='Header'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:filled|transparent)$/]",
        "message": "<Header> variant must be one of 'filled' | 'transparent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|strokeWidth|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, strokeWidth."
      },
      {
        "selector": "JSXOpeningElement[name.name='ImagePlaceholder'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|src|fit|background|radius|ratio|key|ref|className|style|children)$/]",
        "message": "<ImagePlaceholder> doesn't accept that prop. Declared props: label, src, fit, background, radius, ratio."
      },
      {
        "selector": "JSXOpeningElement[name.name='ImagePlaceholder'] > JSXAttribute[name.name='fit'] > Literal[value!=/^(?:contain|cover)$/]",
        "message": "<ImagePlaceholder> fit must be one of 'contain' | 'cover'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Marquee'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|repeat|background|color|size|height|duration|key|ref|className|style|children)$/]",
        "message": "<Marquee> doesn't accept that prop. Declared props: text, repeat, background, color, size, height, duration."
      },
      {
        "selector": "JSXOpeningElement[name.name='PackOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|perCan|saving|key|ref|className|style|children)$/]",
        "message": "<PackOption> doesn't accept that prop. Declared props: id, label, perCan, saving."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|image|line|price|oldPrice|meta|badge|quantity|outOfStock|onAdd|onQuantityChange|key|ref|className|style|children)$/]",
        "message": "<ProductCard> doesn't accept that prop. Declared props: name, image, line, price, oldPrice, meta, badge, quantity, outOfStock, onAdd, onQuantityChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductCard'] > JSXAttribute[name.name='line'] > Literal[value!=/^(?:classic|retro|water|collab)$/]",
        "message": "<ProductCard> line must be one of 'classic' | 'retro' | 'water' | 'collab'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductCard'] > JSXAttribute[name.name='badge'] > Literal[value!=/^(?:new|hit|sale)$/]",
        "message": "<ProductCard> badge must be one of 'new' | 'hit' | 'sale'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|onChange|label|key|ref|className|style|children)$/]",
        "message": "<Select> doesn't accept that prop. Declared props: options, value, onChange, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stepper'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|min|max|onChange|size|key|ref|className|style|children)$/]",
        "message": "<Stepper> doesn't accept that prop. Declared props: value, min, max, onChange, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stepper'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<Stepper> size must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|message|actionLabel|onAction|key|ref|className|style|children)$/]",
        "message": "<Toast> doesn't accept that prop. Declared props: open, message, actionLabel, onAction."
      },
      {
        "selector": "JSXOpeningElement[name.name='WaveDivider'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|above|below|height|flip|key|ref|className|style|children)$/]",
        "message": "<WaveDivider> doesn't accept that prop. Declared props: variant, above, below, height, flip."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
